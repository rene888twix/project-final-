const canvas = document.getElementById('stars-f'); // ищем индекс

const ctx = canvas.getContext('2d'); // рисуем в 2д

function resize() {
canvas.width = window.innerWidth; // растягиваем
canvas.height = window.innerHeight; // растягиваем
}
window.addEventListener('resize', resize);
resize();

class Star {
    constructor() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 1.5; 
        this.opacity = Math.random();    // Начальная прозрачность
        this.speed = Math.random() * 0.02; // Скорость мерцания
    }

    draw() { //рисуем
        ctx.fillStyle = `rgba(255, 255, 255, ${this.opacity})`; //цвет
        ctx.beginPath(); 
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fill();
    }

    update() {
        // меняем прозрачность
        this.opacity += this.speed;
        if (this.opacity > 1 || this.opacity < 0) this.speed = -this.speed;
    }
}


const stars = [];
for (let i = 0; i < 2000; i++) {
    stars.push(new Star());
}

function animate() { //функция
    ctx.clearRect(0, 0, canvas.width, canvas.height); // Очищаем экран перед новым кадром
    
    // Считаем процент прокрутки (от 0 до 1)
    const scrollPercent = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
    
    // Определяем, сколько звезд показать (минимум 100, максимум 2000)
    const countToShow = 100 + (1900 * scrollPercent); //сколько звёзд отобразить в текущем кадре
    
    for (let i = 0; i < countToShow; i++) { //запускает цикл для обработки видимых звёзд
        stars[i].update();
        stars[i].draw(); // вызывает метод draw() для текущей звезды
    }
    //countToShow — динамически меняется в зависимости от прокрутки.
    requestAnimationFrame(animate); // Запускаем следующий кадр
}

animate();  //pfgecr
